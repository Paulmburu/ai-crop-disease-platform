# Copy to .env (never commit it). All values except DATABASE_URL and API_KEYS have defaults.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://crop:crop@localhost:5433/crop?sslmode=disable
# Comma-separated keys accepted in the X-API-Key header
API_KEYS=dev-key
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=1048576
# Admin keys for POST/DELETE /api/v1/model-releases (empty = admin API off).
ADMIN_API_KEYS=dev-admin-key
# Folder with crop_disease_<version>.tflite + .json; each is published on startup.
MODELS_DIR=../python-ml-service/models
ML_SERVICE_URL=http://localhost:8000
RAG_SERVICE_URL=http://localhost:8001
PREDICT_TIMEOUT=10s
ADVICE_TIMEOUT=60s
