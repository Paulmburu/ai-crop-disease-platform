# Copy to .env and adjust. Every value has a sensible default (see app/config.py).
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

MODEL_DIR=models
MODEL_VERSION=v1
# cpu | mps | cuda | auto  (auto picks the Apple GPU on an M-series Mac)
DEVICE=cpu

MAX_UPLOAD_MB=5
CORS_ORIGINS=["http://localhost:3000"]
